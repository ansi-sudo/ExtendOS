#!/usr/bin/env bash
set -euo pipefail
G=/sys/kernel/config/usb_gadget/extendos
F=$G/functions/hid.usb0
mkdir -p "$F"
echo 0 > "$F/protocol"
echo 0 > "$F/subclass"
echo 1 > "$F/report_length"
printf '\x05\x0c\x09\x01\xa1\x01\x15\x00\x25\x01\x75\x01\x95\x08\x09\xe9\x09\xea\x09\xe2\x09\xcd\x09\xb5\x09\xb6\x09\xb7\x09\xb0\x81\x02\xc0' > "$F/report_desc"
ln -sf "$F" "$G/configs/c.1/"

K=$G/functions/hid.usb1
mkdir -p "$K"
echo 0 > "$K/protocol"
echo 0 > "$K/subclass"
echo 8 > "$K/report_length"
printf '\x05\x01\x09\x06\xa1\x01\x05\x07\x19\xe0\x29\xe7\x15\x00\x25\x01\x75\x01\x95\x08\x81\x02\x95\x01\x75\x08\x81\x03\x95\x06\x75\x08\x15\x00\x25\x65\x05\x07\x19\x00\x29\x65\x81\x00\xc0' > "$K/report_desc"
ln -sf "$K" "$G/configs/c.1/"
